# ---------------------------------------------------------------------------
# 저장소 루트의 단일 .env 를 쓴다. 이 파일을 복사해 값을 채운다:
#   cp .env.example .env
# BFF(apps/api)와 Prisma(dotenv-cli)가 모두 이 파일 하나를 읽는다.
# ---------------------------------------------------------------------------

# 키움 OpenAPI 자격증명 (https://openapi.kiwoom.com 에서 발급)
# 실전 앱키와 모의투자 앱키가 다르다. 절대 커밋하지 않는다.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# real | mock — 기본값 mock.
# real 로 바꾸면 실제 주문이 체결된다. 주문 요청 본문의 env 와 이 값이 일치해야
# 서버가 주문을 통과시킨다(오조작 방지 이중 확인).
KIWOOM_ENV=mock

# 실계좌 조회(잔고·미체결) 기능 스위치. 기본 활성.
# false(대소문자 무관)로 두면 /api/account/* 가 503 을 돌려주고,
# 프론트는 잔고 메뉴·페이지를 감춘다. 페이퍼 트레이딩·시세에는 영향 없다.
ACCOUNT_ENABLED=true

# BFF
PORT=4000
WEB_ORIGIN=http://localhost:5173

# 모의투자 경쟁 로그인 토큰 서명 키(HMAC). 아무 긴 임의 문자열이면 된다.
# 바꾸면 발급된 모든 로그인 토큰이 무효가 된다(재로그인 필요).
SESSION_SECRET=change-me-to-a-long-random-string

# 초당 REST 호출 상한. 스펙에 구체적 수치가 없고 유량 초과 에러코드
# (1700/1701/1702)만 정의돼 있어 보수적으로 두고 실측 후 조정한다.
KIWOOM_RPS=4

# Prisma (Supabase Postgres).
# DATABASE_URL: 앱 런타임 — 트랜잭션 모드 풀러(pgbouncer, IPv4). 6543 포트.
# DIRECT_URL:   마이그레이션 전용 — 세션 모드 풀러. 5432 포트.
# Supabase 대시보드의 Connection string 에서 복사하고 [YOUR-PASSWORD] 를 교체한다.
DATABASE_URL="postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

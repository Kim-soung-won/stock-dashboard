# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# 프론트(React+Vite) 이미지. 정적 산출물을 nginx 가 서빙하고, 같은 오리진의
# /api·/ws 를 api 컨테이너로 리버스 프록시한다(단일 포트 10888).
# 앱은 /api·/ws 를 상대경로(same-origin)로 부르므로 빌드타임 환경변수가 필요 없다.
# ---------------------------------------------------------------------------

FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/kiwoom-codes/package.json packages/kiwoom-codes/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile

COPY . .
RUN pnpm build:packages && pnpm --filter @stock/web build

# ---- 서빙 ----
FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 10888

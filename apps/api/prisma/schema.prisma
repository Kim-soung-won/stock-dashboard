// 우리 DB 가 보관하는 것은 "키움에 없는 것"뿐이다.
//
// 시세·잔고·예수금의 진실은 키움 서버에 있으므로 캐시하지 않는다. DB 가 필요한 이유는
// 데이터 보관이 아니라 (1) 주문 멱등성 (2) 접수→체결 사이의 상태 추적 (3) 감사 기록이다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 주문 저널. 키움에 전송하기 **전에** 먼저 이 행을 만든다(멱등키 선점).
/// 키움 주문 API 는 멱등하지 않아 재시도가 곧 중복 주문이 되므로, 중복 판정은
/// 전송 결과가 아니라 이 테이블의 unique 제약이 한다.
model Order {
  id             String   @id @default(cuid())
  /// 클라이언트가 생성한 멱등키. 같은 키의 두 번째 요청은 키움으로 나가지 않는다.
  idempotencyKey String   @unique
  /// 키움이 부여한 주문번호. 접수 전/실패 시 null.
  orderNo        String?
  /// 정정·취소의 원주문번호
  originalOrderNo String?
  code           String
  name           String?
  /// 'buy' | 'sell'
  side           String
  /// 'limit' | 'market'
  orderType      String
  /// 'KRX' | 'NXT' | 'SOR'
  exchange       String
  quantity       Int
  price          Int?
  filledQuantity Int      @default(0)
  averageFilledPrice Int?
  /// contracts 의 OrderStatus
  status         String   @default("submitting")
  /// 'mock' | 'real' — 실전/모의 주문을 절대 섞어 집계하지 않기 위해 행에 기록한다.
  env            String
  failureReason  String?
  /// 키움 요청/응답 원문(감사용). 민감정보(토큰)는 제외하고 저장한다.
  requestSnapshot  String?
  responseSnapshot String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events OrderEvent[]

  @@index([code, createdAt])
  @@index([status])
  @@index([orderNo])
}

/// 주문 상태 전이 이력. 실시간 `00`(주문체결) 이벤트와 우리 판단을 append-only 로 남긴다.
/// 손익·체결 재계산은 이 이력을 되짚어 한다(현재 상태만 덮어쓰지 않는다).
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 'submitted' | 'accepted' | 'filled' | 'partiallyFilled' | 'canceled' | 'rejected' | 'error'
  kind      String
  /// 키움 실시간 913(주문상태) 등 원문 라벨
  sourceLabel String?
  filledQuantity Int?
  filledPrice    Int?
  /// 이벤트 원문 JSON (감사용)
  payload   String?
  occurredAt DateTime @default(now())

  @@index([orderId, occurredAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// 모의투자 경쟁 (페이퍼 트레이딩).
///
/// 시세와 달리 여기서는 우리 DB 가 **진실**이다. 각 참가자는 시즌별로 같은 시드머니로
/// 시작해 실제 시세로 가상 매매하고, 순위는 보유종목을 현재가로 평가해 계산한다.
/// 키움 계좌·주문 API 는 이 도메인에 관여하지 않는다.
/// ─────────────────────────────────────────────────────────────────────────

/// 경쟁 참가자. 닉네임+PIN 만으로 참가한다(캐주얼). PIN 은 scrypt 해시로만 보관한다.
model Participant {
  id           String   @id @default(cuid())
  nickname     String   @unique
  /// scrypt 해시 (`salt:derivedKey`, 둘 다 hex). 평문 PIN 은 저장하지 않는다.
  pinHash      String
  /// SNS 프로필: 한 줄 소개(선택).
  bio          String?
  /// SNS 프로필: 아바타 이모지(선택).
  avatarEmoji  String?
  createdAt    DateTime @default(now())

  portfolios   Portfolio[]
  watchlist    WatchlistItem[]
}

/// 참가자별 관심 종목. 저장하는 것은 코드 + 표시용 이름 스냅샷뿐이고, 시세는 담지 않는다
/// (조회 시 실시간 WS 로 붙인다). `(participantId, code)` 유니크로 같은 종목 중복을 막는다.
model WatchlistItem {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  code          String
  /// 추가 시점의 표시용 이름 스냅샷(코드만으로 담았으면 null).
  name          String?
  createdAt     DateTime    @default(now())

  @@unique([participantId, code])
  @@index([participantId, createdAt])
}

/// 시즌. 이 창(startAt~endAt) 안에서만 체결이 허용되고, 종료 시 순위가 확정된다.
model Season {
  id           String   @id @default(cuid())
  name         String
  /// 시드머니(원). 모두 같은 금액으로 출발한다(기본 1,000,000)
  startingCash Int
  startAt      DateTime
  endAt        DateTime
  /// 'active' 시즌은 동시에 하나만 두는 것을 서비스가 보장한다
  status       String   @default("active")
  createdAt    DateTime @default(now())

  portfolios   Portfolio[]
}

/// (참가자 × 시즌) 포트폴리오. 현금 잔고의 진실. 보유는 Holding, 이력은 PaperTrade.
model Portfolio {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  /// 시드머니 스냅샷(원). 시즌 설정이 바뀌어도 이 참가자의 기준선은 고정된다
  startingCash  Int
  /// 현재 현금 잔고(원)
  cash          Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  holdings      Holding[]
  trades        PaperTrade[]

  /// 한 시즌에 참가자당 포트폴리오 1개
  @@unique([participantId, seasonId])
  @@index([seasonId])
}

/// 보유 종목. 수량 0 이 되면 행을 삭제한다(빈 보유를 남기지 않는다).
model Holding {
  id           String   @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  code         String
  name         String
  quantity     Int
  /// 매입평균가(원, 수수료 제외)
  averagePrice Int
  updatedAt    DateTime @updatedAt

  @@unique([portfolioId, code])
}

/// 가상 체결 저널(append-only). 감사·이력 표시용. 잔고 재계산의 근거이기도 하다.
model PaperTrade {
  id           String   @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  code         String
  name         String
  /// 'buy' | 'sell'
  side         String
  quantity     Int
  /// 체결 단가(원)
  price        Int
  /// 매매수수료(원)
  fee          Int
  /// 거래세(원, 매도만)
  tax          Int
  /// 이 체결로 오간 순현금(원). 매수 음수, 매도 양수
  cashDelta    Int
  createdAt    DateTime @default(now())

  @@index([portfolioId, createdAt])
}

/// 종목 마스터 캐시. 하루 한 번 ka10099 로 갱신하면 되는 정적 데이터라
/// 매 요청 조회로 유량을 쓰지 않기 위해서만 둔다(없어도 동작에 지장 없음).
///
/// **키가 (market, code) 복합키인 이유**: ka10099 의 시장 구분은 배타적이지 않다.
/// 코스피 목록(mrkt_tp=0)에 KOSPI 상장 ETF 가 함께 들어오고, 같은 코드가 ETF
/// 목록(mrkt_tp=8)에도 나온다. code 단일 키로 두면 나중에 조회한 시장이 앞의 것을
/// 덮어써서, 같은 요청이 첫 호출과 두 번째 호출에 다른 개수를 돌려준다(실측).
/// 캐시는 "그 시장을 물어본 결과"이므로 시장별로 따로 보관한다.
model SymbolCache {
  market    String
  code      String
  name      String
  updatedAt DateTime @updatedAt

  @@id([market, code])
}

/// 서비스 사용 이력(감사·분석). 전역 인터셉터가 HTTP 요청 완료마다 append-only 로 적재한다.
///
/// 신원은 두 갈래로 남긴다: (1) `participantId` 는 Bearer 토큰(HMAC)에서 서버가 확정한
/// **신뢰값**이라 비로그인 요청이면 null 이고, (2) `headerUserId` 는 클라이언트가 보낸
/// `X-User-Id`(디바이스/익명 id)로 위조 가능하나 비로그인 트래픽 식별·세션 연결용 보조값이다.
/// 시세 WS 틱은 초당 수십 건이라 대상에서 제외한다(HTTP 만 적재). 요청 본문은 저장하지 않는다.
model ServiceUsageLog {
  id            String   @id @default(cuid())
  /// 토큰에서 확정한 참가자 id(신뢰값). 비로그인이면 null.
  participantId String?
  /// 클라이언트 X-User-Id 헤더(위조 가능, 보조 식별값).
  headerUserId  String?
  /// 'GET' | 'POST' | ...
  method        String
  /// 쿼리스트링을 뗀 경로(/api/...). 민감값이 쿼리에 실릴 수 있어 path 만 남긴다.
  path          String
  statusCode    Int
  /// 처리 소요(ms)
  durationMs    Int
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([participantId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}
